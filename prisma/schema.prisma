generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id                     String             @id @default(cuid())
  handle                 String             @unique
  title                  String
  description            String?            @db.Text
  descriptionHtml        String?            @db.LongText
  price                  Float
  compareAtPrice         Float?
  generalDiscountPercent Float              @default(0)
  wholesaleDiscounts     Json               @default("[]")
  sku                    String?
  inventory              Int                @default(0)
  availableForSale       Boolean            @default(true)
  status                 String             @default("ACTIVE")
  seoTitle               String?
  seoDescription         String?            @db.Text
  canonicalUrl           String?            @db.VarChar(2048)
  robots                 String             @default("index,follow")
  openGraphImage         String?            @db.VarChar(2048)
  imageAlt               String?            @db.Text
  focusKeyword           String?
  images                 Json               @default("[]")
  featuredImage          String?            @db.VarChar(2048)
  productType            String?
  categoryId             String?
  subcategoryId          String?
  vendor                 String             @default("Auerviamaison")
  tags                   Json               @default("[]")
  collectionIds          Json               @default("[]")
  isFeatured             Boolean            @default(false)
  displayOrder           Int                @default(9999)
  details                Json               @default("[]")
  certificates           Json               @default("[]")
  packagingSizes         Json               @default("[]")
  netWeight              String?
  origin                 String?
  shelfLife              String?
  faqs                   Json               @default("[]")
  wholesaleQuoteEnabled  Boolean            @default(false)
  color                  String?
  size                   String?
  storage                String?
  ram                    String?
  processor              String?
  condition              String?
  specifications         Json               @default("{}")
  customAttributes       Json               @default("{}")
  variations             ProductVariation[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  wishlistItems          WishlistItem[]

  @@index([displayOrder])
  @@index([status, displayOrder])
  @@index([categoryId, status])
  @@index([subcategoryId, status])
  @@index([isFeatured, status])
  @@index([updatedAt])
}

model ProductVariation {
  id               String   @id @default(cuid())
  name             String
  value            String   @default("")
  description      String?  @db.Text
  price            Float
  compareAtPrice   Float?
  sku              String?
  stock            Int      @default(0)
  images           Json     @default("[]")
  color            String?
  size             String?
  storage          String?
  ram              String?
  processor        String?
  condition        String?
  specifications   Json     @default("{}")
  customAttributes Json     @default("{}")
  active           Boolean  @default(true)
  isDefault        Boolean  @default(false)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
}

model Collection {
  id              String   @id @default(cuid())
  handle          String   @unique
  title           String
  description     String?  @db.Text
  descriptionHtml String?  @db.LongText
  image           String?  @db.VarChar(2048)
  seoTitle        String?
  seoDescription  String?  @db.Text
  canonicalUrl    String?  @db.VarChar(2048)
  robots          String   @default("index,follow")
  openGraphImage  String?  @db.VarChar(2048)
  imageAlt        String?  @db.Text
  focusKeyword    String?
  productHandles  Json     @default("[]")
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminUser {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  password               String
  name                   String?
  passwordChangedAt      DateTime?
  passwordChangeRequests PasswordChangeRequest[]
  adminAccountRequests   AdminAccountRequest[]
  createdAt              DateTime                @default(now())
}

model AdminAccountRequest {
  id            String    @id @default(cuid())
  requestedById String
  requestedBy   AdminUser @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  action        String
  targetAdminId String?
  newEmail      String
  passwordHash  String?
  otpHash       String
  expiresAt     DateTime
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([requestedById, createdAt])
  @@index([expiresAt])
}

model PasswordChangeRequest {
  id           String    @id @default(cuid())
  adminId      String
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  otpHash      String
  passwordHash String
  expiresAt    DateTime
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([expiresAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model Order {
  id                      String    @id @default(cuid())
  orderNumber             String    @unique
  customerName            String
  customerEmail           String
  customerPhone           String?
  customerAddress         Json // { line1, line2, city, state, pincode, country }
  items                   Json // array of { productId, title, price, quantity, image }
  subtotal                Float
  shippingCost            Float     @default(0)
  tax                     Float     @default(0)
  total                   Float
  discount                Float     @default(0)
  couponCode              String?
  paymentMethod           String    @default("pending")
  paymentStatus           String    @default("pending")
  paymentProofUrl         String?   @db.VarChar(2048)
  transactionReference    String?
  confirmationEmailSentAt DateTime?
  orderStatus             String    @default("pending")
  notes                   String?   @db.Text
  trackingNumber          String?
  trackingUrl             String?   @db.VarChar(2048)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  customerId              String?
  customer                Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([customerEmail])
  @@index([orderStatus])
}

model Customer {
  id              String             @id @default(cuid())
  accessTokenHash String             @unique
  name            String
  email           String?
  phone           String?
  address         Json?
  dateOfBirth     DateTime?
  notes           String?            @db.Text
  cartSnapshot    Json               @default("[]")
  lastActiveAt    DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  orders          Order[]
  wishlistItems   WishlistItem[]
  activities      CustomerActivity[]

  @@index([name])
  @@index([email])
  @@index([phone])
  @@index([lastActiveAt])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
}

model CustomerActivity {
  id          String   @id @default(cuid())
  customerId  String
  type        String
  description String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.LongText
  type      String   @default("contact")
  status    String   @default("unread")
  adminNote String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  description    String?  @db.Text
  image          String?  @db.VarChar(2048)
  parentId       String?
  order          Int      @default(0)
  featured       Boolean  @default(false)
  seoTitle       String?
  seoDescription String?  @db.Text
  canonicalUrl   String?  @db.VarChar(2048)
  robots         String   @default("index,follow")
  openGraphImage String?  @db.VarChar(2048)
  imageAlt       String?  @db.Text
  focusKeyword   String?
  productIds     Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}

model BlogPost {
  id                    String    @id @default(cuid())
  title                 String
  slug                  String    @unique
  excerpt               String?   @db.Text
  content               String?   @db.LongText
  featuredImage         String?   @db.VarChar(2048)
  featuredImageAlt      String?   @db.Text
  openGraphImage        String?   @db.VarChar(2048)
  categoryId            String?
  author                String
  authorId              String?
  authorProfile         Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorRole            String?
  authorBio             String?   @db.Text
  authorImage           String?   @db.VarChar(2048)
  status                String    @default("draft")
  publishedAt           DateTime?
  scheduledAt           DateTime?
  contentRevisedAt      DateTime?
  seoTitle              String?
  seoDescription        String?   @db.Text
  canonicalUrl          String?   @db.VarChar(2048)
  focusKeyword          String?
  relatedKeywords       Json      @default("[]")
  relatedArticleIds     Json      @default("[]")
  relatedProductHandles Json      @default("[]")
  isIndexable           Boolean   @default(true)
  tags                  Json      @default("[]")
  views                 Int       @default(0)
  isFeatured            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([author, status])
  @@index([authorId, status])
}

model Author {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  role      String?
  bio       String?    @db.Text
  image     String?    @db.VarChar(2048)
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Review {
  id                 String   @id @default(cuid())
  authorName         String
  authorEmail        String?
  authorImage        String?  @db.VarChar(2048)
  rating             Int      @default(5)
  content            String   @db.Text
  productId          String?
  productHandle      String?
  isFeatured         Boolean  @default(false)
  status             String   @default("pending") // pending, approved, rejected
  isVerifiedPurchase Boolean  @default(false)
  helpfulCount       Int      @default(0)
  images             Json     @default("[]")
  adminNote          String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@index([isFeatured])
}

model Certificate {
  id                String    @id @default(cuid())
  title             String    @map("name")
  certificateImage  String    @map("image") @db.VarChar(2048)
  shortDescription  String?   @map("description") @db.Text
  displayOrder      Int       @default(0) @map("order")
  active            Boolean   @default(true) @map("isActive")
  featured          Boolean   @default(false) @map("isVerifiedBy")
  organizationName  String    @default("OrganoCity Verified Organization")
  organizationLogo  String    @default("") @db.VarChar(2048)
  orientation       String    @default("LANDSCAPE")
  issueDate         DateTime  @default(now())
  expiryDate        DateTime?
  certificateNumber String?
  verificationUrl   String?   @db.VarChar(2048)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active, displayOrder])
  @@index([featured])
}

model HeroSlide {
  id                String   @id @default(cuid())
  imageUrl          String   @db.VarChar(2048)
  mobileImageUrl    String?  @db.VarChar(2048)
  imageAlt          String   @db.Text
  eyebrow           String
  title             String
  titleHighlight    String
  description       String   @db.Text
  ctaPrimaryLabel   String?
  ctaPrimaryHref    String?  @db.VarChar(2048)
  ctaSecondaryLabel String?
  ctaSecondaryHref  String?  @db.VarChar(2048)
  isActive          Boolean  @default(true)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model HomepageSection {
  id         String   @id @default(cuid())
  sectionKey String   @unique
  title      String?
  subtitle   String?  @db.Text
  content    Json?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  image      String?  @db.VarChar(2048)
  updatedAt  DateTime @updatedAt
}

enum VideoPlatform {
  YOUTUBE
  TIKTOK
  FACEBOOK
  INSTAGRAM
}

enum VideoPlacement {
  HOMEPAGE
  HOMEPAGE_REELS
  ABOUT
  VIDEOS_PAGE
}

enum VideoFormat {
  LANDSCAPE
  VERTICAL
}

model Video {
  id             String         @id @default(cuid())
  title          String
  description    String?        @db.Text
  thumbnail      String?        @db.VarChar(2048)
  videoUrl       String         @db.VarChar(2048)
  embedUrl       String?        @db.VarChar(2048)
  platform       VideoPlatform
  placement      VideoPlacement @default(VIDEOS_PAGE)
  format         VideoFormat    @default(LANDSCAPE)
  buttonText     String?
  buttonUrl      String?        @db.VarChar(2048)
  featured       Boolean        @default(false)
  active         Boolean        @default(true)
  displayOrder   Int            @default(0)
  seoTitle       String?
  seoDescription String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([platform])
  @@index([placement])
  @@index([featured])
  @@index([active])
  @@index([displayOrder])
}

model NavigationMenu {
  id        String   @id @default(cuid())
  location  String   @unique
  items     Json
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  url         String   @db.VarChar(2048)
  publicId    String   @unique
  type        String
  size        Int
  alt         String?  @db.Text
  uploadedBy  String?
  usedIn      String?
  referenceId String?
  createdAt   DateTime @default(now())
}
